<%- include('layouts/head') %>
<p style="margin:0 0 4px 0; font-size:13px; font-weight:600; letter-spacing:0.5px; text-transform:uppercase; color:#ED3131;">Account Suspended</p>
<h1 style="margin:0 0 16px 0; font-size:22px; font-weight:700; color:#18181b; line-height:1.3;">Your merchant subscription has lapsed</h1>
<p style="margin:0 0 16px 0; font-size:15px; line-height:1.6; color:#52525b;">Hi <%= businessName %>,</p>
<p style="margin:0 0 8px 0; font-size:15px; line-height:1.6; color:#52525b;"><% if (reason === 'trial_expired_no_payment_method') { %>Your 14-day free trial has ended and no payment method was added, so your merchant account has been temporarily suspended.<% } else { %>We were unable to process your subscription payment, and your merchant account has been temporarily suspended.<% } %></p>
<p style="margin:0 0 24px 0; font-size:15px; line-height:1.6; color:#52525b;">Add or update your payment method to reactivate your account and resume accepting bookings.</p>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 24px 0;">
  <tr>
    <td align="center">
      <table role="presentation" cellpadding="0" cellspacing="0">
        <tr>
          <td style="background-color:#ED3131; border-radius:999px;">
            <a href="<%= frontendUrl %>/merchant/dashboard/billing" style="display:inline-block; padding:14px 36px; font-size:15px; font-weight:600; color:#ffffff; text-decoration:none;">Update Payment Method</a>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
<%- include('layouts/foot', { frontendUrl, year }) %>
